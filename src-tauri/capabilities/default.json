{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://www.pathofexile.com/*" },
        { "url": "https://poe.ninja/*" },
        { "url": "https://www.poeprices.info/*" }
      ]
    }
  ]
}
