{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Price of Exile",
  "version": "0.1.8",
  "identifier": "com.artemna.poe-trade-overlay",
  "build": {
    "frontendDist": "../dist/price-of-exile/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Price of Exile",
        "width": 900,
        "height": 640,
        "visible": false,
        "resizable": true
      },
      {
        "label": "popup",
        "title": "Price of Exile — popup",
        "width": 820,
        "height": 590,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "toast",
        "title": "Price of Exile — started",
        "width": 340,
        "height": 92,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "ArtemNA",
    "shortDescription": "Path of Exile price check overlay",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QzlGRkU3OURBMDk3NDUKUldSRmw2Q2Q1Ly9KOU9SUTl3dXViWUJyNnprZmVTeG5rUzcvUTNtdUI4VGZEYVlNUWZWMCtyemwK",
      "endpoints": [
        "https://github.com/ArtemNA/price-of-exile/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
